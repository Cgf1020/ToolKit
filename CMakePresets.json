{
  "version": 6,
  "configurePresets": [
    {
      "name": "vs2022-clangcl",
      "displayName": "VS 2022 + ClangCL",
      "description": "Visual Studio 17 2022 + ClangCL toolset (IDE build)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "toolset": "ClangCL",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "ENABLE_WEBSOCKET": "OFF",
        "BUILD_SHARED_LIBS": "ON"
      }
    },
    {
      "name": "ninja-clangcl",
      "displayName": "Ninja + LLVM clang-cl",
      "description": "LLVM clang-cl + Ninja + lld-link; exports compile_commands.json",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/clangcl-db.cmake",
        "CMAKE_TRY_COMPILE_TARGET_TYPE": "STATIC_LIBRARY",
        "ENABLE_WEBSOCKET": "OFF",
        "BUILD_SHARED_LIBS": "ON"
      }
    },
    {
      "name": "vs2022-msvc",
      "displayName": "VS 2022 + MSVC",
      "description": "Visual Studio 17 2022 + MSVC (cl) toolset (IDE build)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build-msvc",
      "cacheVariables": {
        "ENABLE_WEBSOCKET": "OFF",
        "BUILD_SHARED_LIBS": "ON"
      }
    },
    {
      "name": "ninja-msvc",
      "displayName": "Ninja + MSVC",
      "description": "MSVC cl + Ninja (run from x64 Native Tools Command Prompt); Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-msvc-ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "ENABLE_WEBSOCKET": "OFF",
        "BUILD_SHARED_LIBS": "ON"
      }
    },
    {
      "name": "ninja-linux",
      "displayName": "Ninja (Linux)",
      "description": "Linux system compiler + Ninja; Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "ENABLE_WEBSOCKET": "OFF",
        "BUILD_SHARED_LIBS": "ON"
      }
    },
    {
      "name": "makefile-gcc",
      "displayName": "Unix Makefiles + GCC",
      "description": "Linux GCC g++ + Unix Makefiles; Debug",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-gcc",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "ENABLE_WEBSOCKET": "OFF",
        "BUILD_SHARED_LIBS": "ON"
      }
    },
    {
      "name": "ninja-gcc",
      "displayName": "Ninja + GCC",
      "description": "Linux GCC g++ + Ninja; Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-gcc-ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "ENABLE_WEBSOCKET": "OFF",
        "BUILD_SHARED_LIBS": "ON"
      }
    },
    {
      "name": "makefile-clang",
      "displayName": "Unix Makefiles + Clang",
      "description": "Linux Clang clang++ + Unix Makefiles; Debug",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-clang",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "ENABLE_WEBSOCKET": "OFF",
        "BUILD_SHARED_LIBS": "ON"
      }
    },
    {
      "name": "ninja-clang",
      "displayName": "Ninja + Clang",
      "description": "Linux Clang clang++ + Ninja; Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-clang-ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "ENABLE_WEBSOCKET": "OFF",
        "BUILD_SHARED_LIBS": "ON"
      }
    },
    {
      "name": "ninja-linux-release",
      "inherits": "ninja-linux",
      "displayName": "Ninja (Linux) Release",
      "description": "Linux system compiler + Ninja; Release",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "makefile-gcc-release",
      "inherits": "makefile-gcc",
      "displayName": "Unix Makefiles + GCC Release",
      "description": "Linux GCC g++ + Unix Makefiles; Release",
      "binaryDir": "${sourceDir}/build-gcc-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "ninja-gcc-release",
      "inherits": "ninja-gcc",
      "displayName": "Ninja + GCC Release",
      "description": "Linux GCC g++ + Ninja; Release",
      "binaryDir": "${sourceDir}/build-gcc-ninja-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "makefile-clang-release",
      "inherits": "makefile-clang",
      "displayName": "Unix Makefiles + Clang Release",
      "description": "Linux Clang clang++ + Unix Makefiles; Release",
      "binaryDir": "${sourceDir}/build-clang-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "ninja-clang-release",
      "inherits": "ninja-clang",
      "displayName": "Ninja + Clang Release",
      "description": "Linux Clang clang++ + Ninja; Release",
      "binaryDir": "${sourceDir}/build-clang-ninja-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "ninja-macos",
      "displayName": "Ninja + LLVM (macOS)",
      "description": "LLVM clang++ + Ninja (+ lld when available); exports compile_commands.json",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/llvm-macos.cmake",
        "CMAKE_TRY_COMPILE_TARGET_TYPE": "STATIC_LIBRARY",
        "ENABLE_WEBSOCKET": "OFF",
        "BUILD_SHARED_LIBS": "ON"
      }
    },
    {
      "name": "xcode-macos",
      "displayName": "Xcode (macOS)",
      "description": "macOS multi-config Xcode build (requires full Xcode.app)",
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/build",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "ENABLE_WEBSOCKET": "OFF",
        "BUILD_SHARED_LIBS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "displayName": "Debug",
      "configurePreset": "vs2022-clangcl",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "displayName": "Release",
      "configurePreset": "vs2022-clangcl",
      "configuration": "Release"
    },
    {
      "name": "ninja-toolkit",
      "displayName": "Ninja ToolKit (sync compile_commands)",
      "configurePreset": "ninja-clangcl",
      "targets": ["ToolKit"]
    },
    {
      "name": "msvc-debug",
      "displayName": "MSVC Debug",
      "configurePreset": "vs2022-msvc",
      "configuration": "Debug"
    },
    {
      "name": "msvc-release",
      "displayName": "MSVC Release",
      "configurePreset": "vs2022-msvc",
      "configuration": "Release"
    },
    {
      "name": "ninja-msvc-toolkit",
      "displayName": "Ninja MSVC ToolKit",
      "configurePreset": "ninja-msvc",
      "targets": ["ToolKit"]
    },
    {
      "name": "linux-debug",
      "displayName": "Linux Debug",
      "configurePreset": "ninja-linux",
      "targets": ["ToolKit"]
    },
    {
      "name": "linux-gcc",
      "displayName": "Linux GCC Debug",
      "configurePreset": "makefile-gcc",
      "targets": ["ToolKit"]
    },
    {
      "name": "linux-gcc-ninja",
      "displayName": "Linux GCC Ninja Debug",
      "configurePreset": "ninja-gcc",
      "targets": ["ToolKit"]
    },
    {
      "name": "linux-clang",
      "displayName": "Linux Clang Debug",
      "configurePreset": "makefile-clang",
      "targets": ["ToolKit"]
    },
    {
      "name": "linux-clang-ninja",
      "displayName": "Linux Clang Ninja Debug",
      "configurePreset": "ninja-clang",
      "targets": ["ToolKit"]
    },
    {
      "name": "linux-release",
      "displayName": "Linux Release",
      "configurePreset": "ninja-linux-release",
      "targets": ["ToolKit"]
    },
    {
      "name": "linux-gcc-release",
      "displayName": "Linux GCC Release",
      "configurePreset": "makefile-gcc-release",
      "targets": ["ToolKit"]
    },
    {
      "name": "linux-gcc-ninja-release",
      "displayName": "Linux GCC Ninja Release",
      "configurePreset": "ninja-gcc-release",
      "targets": ["ToolKit"]
    },
    {
      "name": "linux-clang-release",
      "displayName": "Linux Clang Release",
      "configurePreset": "makefile-clang-release",
      "targets": ["ToolKit"]
    },
    {
      "name": "linux-clang-ninja-release",
      "displayName": "Linux Clang Ninja Release",
      "configurePreset": "ninja-clang-release",
      "targets": ["ToolKit"]
    },
    {
      "name": "macos-debug",
      "displayName": "macOS Debug",
      "configurePreset": "ninja-macos",
      "targets": ["ToolKit"]
    }
  ]
}